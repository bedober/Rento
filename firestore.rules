rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && userDoc().data.role != null ? userDoc().data.role : ""; }
    function admin() { return signedIn() && (role() == "SUPER_ADMIN" || request.auth.token.role == "SUPER_ADMIN"); }
    function landlordOf(propertyId) {
      return signedIn() && get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId == request.auth.uid;
    }
    match /app_config/{id} {
      allow read: if signedIn();
      allow write: if false; // All config mutation is validated by updateAppConfig callable.
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == "UNSELECTED";
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["walletBalance","kycStatus","nationalId","role","kycStatus","isAdmin","admin","permissions"]);
      allow delete: if admin();
    }
    match /wallets/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
    }
    match /wallet_transactions/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.counterpartyUid == request.auth.uid || admin());
      allow write: if false;
    }
    match /rent_invoices/{id} {
      allow read: if signedIn() && (resource.data.tenantId == request.auth.uid || resource.data.landlordId == request.auth.uid || admin());
      allow write: if false;
    }
    match /properties/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (admin() || (role() == "LANDLORD" && request.resource.data.landlordId == request.auth.uid && (request.method == "create" || resource.data.landlordId == request.auth.uid)));
    }
    match /units/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (admin() || (role() == "LANDLORD" && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.landlordId == request.auth.uid));
    }
    match /maintenance/{id} {
      allow read: if signedIn() && (resource.data.tenantId == request.auth.uid || resource.data.landlordId == request.auth.uid || admin());
      allow create: if false; // Created through validated callable only.
      allow update: if signedIn() && (resource.data.landlordId == request.auth.uid || admin());
      allow delete: if admin();
    }
    match /conversations/{id}/messages/{messageId} {
      allow read, create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantUids;
      allow update, delete: if false;
    }
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (role() == "LANDLORD" || admin());
    }
    match /{document=**} { allow read, write: if false; }
  }
}