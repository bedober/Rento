rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
    function validUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
    }

    // Private user documents and profile images.
    match /users/{uid}/{allPaths=**} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validUpload();
      allow delete: if signedInAs(uid);
    }

    // Property media is readable by signed-in users; only trusted backend code writes it.
    match /properties/{propertyId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}